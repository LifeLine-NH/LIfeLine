{
  "name": "@lifeline/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:agents": "pnpm --filter @lifeline/agents build && node -e \"require('fs').cpSync('../agents/src/prompts','../agents/dist/prompts',{recursive:true})\"",
    "predev": "pnpm build:agents",
    "dev": "next dev",
    "prebuild": "pnpm build:agents",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@lifeline/agents": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "near-workspaces": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.26.2"
}
