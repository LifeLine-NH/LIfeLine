NEXT_PUBLIC_NEAR_RPC_URL=
NEXT_PUBLIC_POOL_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_POOL_TOKEN_DECIMALS=6
# Server only: where evidence records are stored, served as <base>/<sha256>
EVIDENCE_BASE_URL=
