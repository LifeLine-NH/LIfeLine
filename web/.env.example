# stub (sample data, no contract), testnet or mainnet
NEXT_PUBLIC_CHAIN_MODE=stub
# replay (recorded agent runs) or live
NEXT_PUBLIC_DATA_MODE=replay
# Relief contract account, from developer A
NEXT_PUBLIC_CONTRACT_ID=
# Optional: defaults to the public RPC for the chosen network
NEXT_PUBLIC_NEAR_RPC_URL=
NEXT_PUBLIC_POOL_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_POOL_TOKEN_DECIMALS=6
# Server only: where evidence records are stored, served as <base>/<sha256>
EVIDENCE_BASE_URL=

# Donations
# NEP-141 token the pool accepts (testnet: A's mock-ft account)
NEXT_PUBLIC_POOL_TOKEN_ID=
# msg passed to ft_transfer_call; must match what the relief contract's ft_on_transfer expects
NEXT_PUBLIC_DONATION_MSG=
# Gas attached to ft_transfer_call, in TGas
NEXT_PUBLIC_DONATE_GAS_TGAS=150
# testnet only: show the "Get test tokens" button (needs a public mint(to, amount) on the token)
NEXT_PUBLIC_TEST_TOKEN_FAUCET=false

# NEAR Intents payout quotes (server only, mainnet: 1Click has no testnet)
# Optional partner key from the 1Click portal. Without it quotes still work but carry a small service fee.
ONECLICK_API_KEY=
# Valid mainnet NEAR account sent as refundTo. Dry quotes never use it; defaults to intents.near
ONECLICK_REFUND_TO=
