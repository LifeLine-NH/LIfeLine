# ==============================================================================
# LIFELINE — Environment Configuration (.env.example)
# Copy to .env and fill with your keys. NEVER commit .env to git.
# ==============================================================================

# NEAR Network & Contract Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
CONTRACT_ID=lifeline-demo.testnet
CHAIN_MODE=stub # "stub" (offline emulator) or "testnet" (live NEAR RPC)

# Intake Oracle Account (Function-call key restricted to submit_case)
INTAKE_ACCOUNT_ID=intake.lifeline-demo.testnet
INTAKE_PRIVATE_KEY=

# Verifier Swarm Accounts (Function-call keys restricted to vote, vote_delivery)
V_GEO_ACCOUNT_ID=v-geo.lifeline-demo.testnet
V_GEO_PRIVATE_KEY=

V_FACT_ACCOUNT_ID=v-fact.lifeline-demo.testnet
V_FACT_PRIVATE_KEY=

V_SEV_ACCOUNT_ID=v-sev.lifeline-demo.testnet
V_SEV_PRIVATE_KEY=

V_RED_ACCOUNT_ID=v-red.lifeline-demo.testnet
V_RED_PRIVATE_KEY=

# Simulated NGO Responder Accounts (register_ngo, place_bid, submit_proof)
NGO_1_ACCOUNT_ID=ngo-rapid.lifeline-demo.testnet
NGO_1_PRIVATE_KEY=

NGO_2_ACCOUNT_ID=ngo-balanced.lifeline-demo.testnet
NGO_2_PRIVATE_KEY=

NGO_3_ACCOUNT_ID=ngo-frugal.lifeline-demo.testnet
NGO_3_PRIVATE_KEY=

# LLM Provider #1 — Zero-Cost Free Tier (Groq OpenAI-compatible endpoint: https://console.groq.com/keys)
# Can also point to NEAR AI Cloud (https://cloud-api.near.ai/v1) if you have NEAR credits
NEAR_AI_BASE_URL=https://api.groq.com/openai/v1
NEAR_AI_API_KEY=
FACT_MODEL_ID=openai/gpt-oss-120b
SEV_MODEL_ID=qwen/qwen3.8-27b

# LLM Provider #2 — Zero-Cost Secondary Independent Provider (Google AI Studio Free Tier: https://aistudio.google.com/apikey)
# Or fallback to Groq's third distinct model (openai/gpt-oss-20b) when SECONDARY_LLM_API_KEY is empty
SECONDARY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SECONDARY_LLM_API_KEY=
RED_MODEL_ID=openai/gpt-oss-20b

# External Evidence Tool Keys (Optional in replay mode)
NASA_FIRMS_KEY=
RELIEFWEB_APPNAME=lifeline-near-hackathon

# Execution / Recording Mode
SWARM_MODE=replay # "replay" or "live"
RECORD_LLM=false

# Where the agent runner and /api/evidence read and write evidence records.
# Defaults to ./storage/evidence under the working directory. On Vercel the deployed
# filesystem is read-only except /tmp, and /tmp is not shared between instances.
AGENT_EVIDENCE_DIR=

# ==============================================================================
# WEBSITE (web/) — read by Next.js. Full comments in web/.env.example.
# The website reads NEXT_PUBLIC_CHAIN_MODE, NOT CHAIN_MODE. For a testnet site set BOTH:
#   CHAIN_MODE=testnet              (server-side swarm runner)
#   NEXT_PUBLIC_CHAIN_MODE=testnet  (website)
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.
# Anything prefixed NEXT_PUBLIC_ is public in the browser. Never put keys in one.
# ==============================================================================
NEXT_PUBLIC_CHAIN_MODE=stub # "stub", "testnet" or "mainnet"
NEXT_PUBLIC_DATA_MODE=replay # "replay" or "live"; the header badge reads this
NEXT_PUBLIC_CONTRACT_ID= # lifeline-demo.testnet
NEXT_PUBLIC_NEAR_RPC_URL= # use the same endpoint as NEAR_RPC_URL above
NEXT_PUBLIC_POOL_TOKEN_ID= # usdc.lifeline-demo.testnet
NEXT_PUBLIC_POOL_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_POOL_TOKEN_DECIMALS=6 # mock-ft uses 6
NEXT_PUBLIC_DONATION_MSG= # empty: ft_on_transfer keeps the full amount (see docs/DONATIONS.md)
NEXT_PUBLIC_DONATE_GAS_TGAS=150
NEXT_PUBLIC_TEST_TOKEN_FAUCET=false # "true" on testnet only, never on a mainnet build
NEXT_PUBLIC_NGO_BOND_NEAR=1 # contract accepts any bond > 0; 1 NEAR is the documented amount
EVIDENCE_BASE_URL= # server only: optional external record store, served as <base>/<sha256>
ONECLICK_API_KEY= # server only
ONECLICK_REFUND_TO= # server only
