# stub (sample data, no contract), testnet or mainnet
NEXT_PUBLIC_CHAIN_MODE=stub
# replay (recorded agent runs) or live
NEXT_PUBLIC_DATA_MODE=replay
# Relief contract account, from developer A
NEXT_PUBLIC_CONTRACT_ID=
